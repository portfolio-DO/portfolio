# ═══════════════════════════════════════════════════════════
#  Binance Trading Bot - Konfiguracja
#  copy .env.example .env   (Windows)
#  cp .env.example .env     (Linux/Mac)
# ═══════════════════════════════════════════════════════════

# ── Klucze API Binance ──────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# BINANCE_MODE: skad masz klucze?
#   demo  -> klucze z demo.binance.com  (uzywa demo-api.binance.com) ✅
#   real  -> klucze z binance.com       (uzywa api.binance.com) ⚠️
BINANCE_MODE=demo

# BOT_MODE: jak ma dzialac bot?
#   demo       -> polaczone z Binance Demo, handluje wirtualnymi
#   real       -> polaczone z prawdziwym Binance ⚠️
#   goal       -> handluj do osiagniecia TARGET
#   continuous -> non-stop
#   paper      -> lokalna symulacja, zero API
BOT_MODE=demo

# ── Finanse (USDT) ──────────────────────────────────────────
BUDGET=1000.0
TARGET=1500.0
CAPITAL_PER_TRADE_PCT=5.0

# ── Ryzyko ──────────────────────────────────────────────────
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=5.0
MAX_DAILY_LOSS_PCT=10.0
MAX_OPEN_POSITIONS=5

# ── Strategia ───────────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0
SMA_SHORT=50
SMA_LONG=200
KLINE_INTERVAL=1h
LOOP_INTERVAL=10

# ── Serwer ──────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
