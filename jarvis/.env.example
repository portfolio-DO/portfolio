# ============================================
# JARVIS Configuration
# ============================================

# ============================================================
# BACKEND AI - wybierz jedno (priorytet: Ollama > Groq > Gemini)
# ============================================================

# --- OPCJA 1: Ollama (NAJLEPSZA - lokalny, offline, zero limitow) ---
# 1. Pobierz i zainstaluj: https://ollama.com/download
# 2. W terminalu uruchom: ollama pull llama3.2
# 3. Ollama wykrywany automatycznie - nic nie wpisuj!
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Inne dobre modele: mistral, gemma2, phi3, qwen2.5

# --- OPCJA 2: Groq (szybki, darmowy, wymaga internetu) ---
# 1. Zaloz konto (30 sekund): https://console.groq.com
# 2. Wygeneruj klucz API (bezplatny)
# 3. Wklej ponizej:
GROQ_API_KEY=
# Modele Groq (wszystkie darmowe):
#   llama-3.1-8b-instant   - najszybszy (ZALECANY)
#   llama-3.3-70b-versatile - madrzejszy
#   gemma2-9b-it            - alternatywa
GROQ_MODEL=llama-3.1-8b-instant

# --- OPCJA 3: Google Gemini (ograniczony darmowy tier, 15 req/min) ---
# Pobierz klucz: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# Wake Word (openwakeword - darmowy, lokalny, bez klucza)
# ============================================================
# Dostepne: jarvis, alexa, computer, hey mycroft
WAKE_WORD=jarvis
WAKE_WORD_THRESHOLD=0.5

# ============================================================
# Speech-to-Text (Whisper - lokalny)
# ============================================================
# tiny.en=najszybszy | base.en=balans | small.en=dokladny | medium.en/large-v3=najlepszy
STT_MODEL=base.en
STT_DEVICE=cpu
STT_LANGUAGE=en

# ============================================================
# Text-to-Speech
# ============================================================
TTS_ENGINE=pyttsx3
# Dla premium TTS:
# ELEVENLABS_API_KEY=twoj-klucz
# TTS_ENGINE=elevenlabs

# ============================================================
# Safety
# ============================================================
REQUIRE_CONFIRMATION=true
SANDBOX_MODE=false

# ============================================================
# Pluginy (opcjonalne)
# ============================================================
# Darmowy klucz pogody: https://openweathermap.org/api
WEATHER_API_KEY=

# ============================================================
# Siec i logi
# ============================================================
WEBSOCKET_PORT=8765
BACKEND_HOST=localhost
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log
