{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "description": "JARVIS AI Desktop Assistant",
  "main": "src/main/index.js",
  "scripts": {
    "start": "concurrently \"npm run vite\" \"npm run electron\"",
    "vite": "vite",
    "electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "keywords": [
    "ai",
    "assistant",
    "jarvis",
    "voice",
    "automation"
  ],
  "author": "JARVIS",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.10",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "JARVIS",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
