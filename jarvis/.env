# JARVIS Configuration

# --- Groq (aktywny) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Ollama (lokalny, wykrywany automatycznie jesli zainstalowany) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Google Gemini (fallback) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Wake Word ---
WAKE_WORD=jarvis
WAKE_WORD_THRESHOLD=0.5

# --- STT ---
STT_MODEL=base.en
STT_DEVICE=cpu
STT_LANGUAGE=en

# --- TTS ---
TTS_ENGINE=pyttsx3

# --- Safety ---
REQUIRE_CONFIRMATION=true
SANDBOX_MODE=false

# --- Plugins ---
WEATHER_API_KEY=

# --- Network ---
WEBSOCKET_PORT=8765
BACKEND_HOST=localhost
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log
