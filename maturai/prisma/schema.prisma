// MaturAI — Prisma Schema
// Uruchom: npx prisma db push && npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// UŻYTKOWNIK
// ============================================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relacje NextAuth
  accounts      Account[]
  sessions      Session[]

  // Subskrypcja
  subscription  Subscription?

  // Próby
  essays        Essay[]
  mathAttempts  MathAttempt[]
  synthAttempts SynthesisAttempt[]

  // Statystyki
  stats         UserStats?

  @@map("users")
}

// ============================================================
// NEXTAUTH
// ============================================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// SUBSKRYPCJA
// ============================================================
enum SubscriptionPlan {
  FREE
  PREMIUM
}

model Subscription {
  id        String           @id @default(cuid())
  userId    String           @unique
  plan      SubscriptionPlan @default(FREE)
  createdAt DateTime         @default(now())
  expiresAt DateTime?
  isActive  Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ============================================================
// ROZPRAWKA
// ============================================================
model Essay {
  id        String   @id @default(cuid())
  userId    String
  topic     String   @db.Text
  content   String   @db.Text
  wordCount Int      @default(0)

  // Wynik CKE
  totalScore     Int?
  maxScore       Int?  @default(35)
  criteriaJson   String? @db.Text  // JSON z kryteriami
  feedbackJson   String? @db.Text  // JSON z feedbackiem
  summary        String? @db.Text
  isPremiumAnalysis Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  errorAnalysis ErrorAnalysis?

  @@map("essays")
}

// ============================================================
// PRÓBA MATEMATYCZNA
// ============================================================
model MathAttempt {
  id        String @id @default(cuid())
  userId    String
  level     String @default("podstawowa") // podstawowa | rozszerzona

  tasksJson   String  @db.Text  // JSON z zadaniami
  answersJson String? @db.Text  // JSON z odpowiedziami
  score       Int     @default(0)
  maxScore    Int     @default(0)
  isPremium   Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("math_attempts")
}

// ============================================================
// NOTATKA SYNTETYZUJĄCA
// ============================================================
model SynthesisAttempt {
  id      String @id @default(cuid())
  userId  String
  topic   String @db.Text

  sourcesJson String @db.Text  // JSON z tekstami źródłowymi
  content     String @db.Text  // Tekst ucznia

  totalScore   Int?
  maxScore     Int?  @default(15)
  criteriaJson String? @db.Text
  summary      String? @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("synthesis_attempts")
}

// ============================================================
// STATYSTYKI UŻYTKOWNIKA
// ============================================================
model UserStats {
  id     String @id @default(cuid())
  userId String @unique

  totalEssays     Int @default(0)
  totalMathTasks  Int @default(0)
  totalSynthesis  Int @default(0)
  currentStreak   Int @default(0)
  longestStreak   Int @default(0)
  lastStudyDate   DateTime?

  avgEssayScore   Float @default(0)
  avgMathScore    Float @default(0)
  avgSynthScore   Float @default(0)

  level      Int    @default(1)
  xp         Int    @default(0)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// ============================================================
// ANALIZA BŁĘDÓW
// ============================================================
model ErrorAnalysis {
  id      String @id @default(cuid())
  essayId String @unique

  languageErrors      Int @default(0)
  spellingErrors      Int @default(0)
  punctuationErrors   Int @default(0)
  stylisticErrors     Int @default(0)
  factualErrors       Int @default(0)

  errorsJson String? @db.Text  // Szczegółowe błędy z pozycjami

  essay Essay @relation(fields: [essayId], references: [id], onDelete: Cascade)

  @@map("error_analyses")
}
